@model RaceDay.MVC.Models.EventDetailsViewModel

<div class="container">

    <h2>@Model.Event.EventName</h2>

    <p>@Model.Event.Description</p>

    <p>
        <strong>Date:</strong>
        @Model.Event.EventDate.ToShortDateString()
    </p>

    <p>
        <strong>Location:</strong>
        @Model.Event.Location
    </p>

    <h4>Race Categories</h4>

    @foreach(var category in Model.Categories)
    {
        <div class="card mb-3">

            <div class="card-body">

                <h5>
                    @category.CategoryName
                </h5>

                <p>
                    @category.Description
                </p>

                <span class="badge bg-primary">
                    @category.DistanceKM KM
                </span>

                <form asp-action="Enrol"
                      method="post">

                    <input type="hidden"
                           name="categoryId"
                           value="@category.CategoryId" />

                    <button
                        class="btn btn-success mt-2">

                        Enrol
                    </button>

                </form>

            </div>

        </div>
    }

</div>
