@model IEnumerable<RaceDay.MVC.Models.ResultViewModel>

<div class="container mt-4">

    <h2>My Results</h2>

    <table class="table table-striped">

        <thead>
            <tr>
                <th>Event</th>
                <th>Date</th>
                <th>Category</th>
                <th>Finish Time</th>
                <th>Position</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var result in Model)
            {
                <tr>

                    <td>@result.EventName</td>

                    <td>
                        @result.EventDate.ToShortDateString()
                    </td>

                    <td>
                        @result.CategoryName
                    </td>

                    <td>
                        @result.FinishTime
                    </td>

                    <td>
                        @result.Position
                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>