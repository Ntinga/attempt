@model RaceDay.MVC.Models.ResultEntryViewModel

<div class="container mt-4">

    <h2>Record Result</h2>

    <form asp-action="EnterResult"
          method="post">
        <div asp-validation-summary="All"
             class="text-danger">
        </div>

        <input asp-for="EnrolmentId"
               type="hidden" />

        <div class="mb-3">

            <label asp-for="FinishTime"></label>

            <input asp-for="FinishTime"
                   class="form-control" />

            <span asp-validation-for="FinishTime"
                  class="text-danger"></span>

        </div>

        <div class="mb-3">

            <label asp-for="Position"></label>

            <input asp-for="Position"
                   class="form-control" />

            <span asp-validation-for="Position"
                  class="text-danger"></span>

        </div>

        <button type="submit"
                class="btn btn-success">

            Publish Result

        </button>

    </form>

</div>
