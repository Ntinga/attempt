@model RaceDay.MVC.Models.ProfileViewModel

<div class="container">

    <h2>My Profile</h2>

    <div class="card">

        <div class="card-body">

            <div class="mb-3">
                <label class="form-label">
                    Full Name
                </label>

                <input asp-for="FullName"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Email
                </label>

                <input asp-for="Email"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label>
                    Profile Picture
                </label>

                <input type="file"
                       class="form-control" />
            </div>

            <button class="btn btn-primary">
                Save Changes
            </button>

        </div>

    </div>

</div>