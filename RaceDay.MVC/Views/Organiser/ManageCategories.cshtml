@model IEnumerable<RaceDay.MVC.Models.CategoryDto>

<div class="container mt-4">

    <h2>Category Management</h2>

    <a asp-action="CreateCategory"
       class="btn btn-primary mb-3">

        Add Category

    </a>

    <table class="table">

        <thead>
            <tr>
                <th>Name</th>
                <th>Distance</th>
                <th>Event Id</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var category in Model)
            {
                <tr>
                    <td>
                        @category.CategoryName
                    </td>

                    <td>
                        @category.DistanceKM km
                    </td>

                    <td>
                        @category.EventId
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>